NODE_ENV=development

# Your live site URL (Vercel domain or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sukh_khokhar_mystery_art?retryWrites=true&w=majority

# Auth secrets (use long random strings in production)
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-this-cookie-secret-min-32-chars

# Admin (npm run seed)
ADMIN_SEED_EMAIL=admin@sukhkhokharmysteryart.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# Email
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=your-email@outlook.com
SMTP_APP_PASSWORD=your-outlook-app-password
ADMIN_NOTIFICATION_EMAIL=your-email@outlook.com

MAX_UPLOAD_SIZE_MB=10
